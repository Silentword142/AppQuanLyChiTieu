<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vinaspends.mai"
    android:versionCode="1"
    android:versionName="4.4.0">

    <uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />
    <!-- Firebase, Gemini (phân tích giao dịch) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ghi giao dịch bằng giọng nói ("Mai ơi, ...") -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Nghe "Mai ơi" cả khi khoá màn hình: dịch vụ nền loại micro + giữ CPU thức + thông báo "Mai đang nghe" -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11+: được thấy dịch vụ nhận giọng nói của Google -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:label="Mai"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|uiMode|screenLayout|smallestScreenSize"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".MaiNotificationListener"
            android:label="Mai – đọc biến động số dư"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".MaiVoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
