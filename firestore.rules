rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi tài khoản Firebase chỉ được đọc/ghi đúng bản sao lưu của chính mình (khoá theo UID).
    match /vinaspends_backups/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Bộ não riêng của Mai (điều Mai đã học từ anh) – cũng chỉ chủ tài khoản đọc/ghi
      match /mai/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Mai học cùng mọi người (ẩn danh): mỗi từ khoá cửa hàng là 1 tài liệu
    //   { t: "tu_khoa", u: { <uid>: "Hạng mục" }, at: thời điểm }
    // Ai đăng nhập cũng đọc được; mỗi người CHỈ được thêm/sửa/xoá đúng phiếu của mình.
    match /mai_community/{tok} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && tok.matches('^[a-z0-9_]{3,40}$')
        && request.resource.data.keys().hasOnly(['t', 'u', 'at'])
        && request.resource.data.t == tok
        && request.resource.data.u.keys().hasOnly([request.auth.uid])
        && request.resource.data.u[request.auth.uid] is string
        && request.resource.data.u[request.auth.uid].size() <= 60;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['t', 'u', 'at'])
        && request.resource.data.t == resource.data.t
        && request.resource.data.u.diff(resource.data.u).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in request.resource.data.u)
            || (request.resource.data.u[request.auth.uid] is string && request.resource.data.u[request.auth.uid].size() <= 60))
        && request.resource.data.u.size() <= 20000;
      allow delete: if false;
    }
  }
}
