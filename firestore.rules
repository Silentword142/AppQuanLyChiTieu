rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi tài khoản Firebase (Google) chỉ được đọc/ghi đúng bản sao lưu của chính mình,
    // khoá theo UID Firebase (không phải email, vì email có thể trùng cách viết hoa/thường).
    match /vinaspends_backups/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
